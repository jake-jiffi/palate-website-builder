---
/**
 * THE PIECE, ALONE, IN ONE STATE. No chrome, nothing else in the document.
 *
 * This is what the state browser puts inside its frame, and it is also a perfectly good URL on
 * its own: it is what a screenshot wants, and what you send a colleague who is going to open it
 * on a phone. Because the frame is the viewport, a piece whose small-screen behaviour only exists
 * below a breakpoint can finally be looked at without resizing the whole browser.
 *
 * It renders the REAL component with the REAL sample content, plus whatever the state's fixture
 * overrides. A piece that will not compile, will not render, or throws on its own defaults fails
 * the build here rather than on a client's site, which is the same guarantee the resting page has
 * always given, now extended across every state the manifest declares.
 *
 * noindex, and gate-shipready removes the whole kit surface at handover.
 */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import StateDriver from "../../../../components/kitdemo/StateDriver.astro";
import { kit } from "../../../../lib/kit";
import { kitSamples } from "../../../../lib/kit-sample";
import { statePropsFor, STATE_KIND, OPEN_TARGET, type KitDemoState } from "../../../../lib/kit-states";

export function getStaticPaths() {
  return kit.flatMap((piece) =>
    piece.variations.flatMap((v) =>
      // "rest" is always offered, so the frame URL exists for a piece that declares no states.
      ["rest", ...v.states].map((state) => ({
        params: { piece: piece.id, variation: v.id, state },
        props: { piece, variation: v, state },
      })),
    ),
  );
}

const { piece, variation, state } = Astro.props;

const modules = import.meta.glob("../../../../components/kit/**/*.astro", { eager: true });
const key = Object.keys(modules).find((k) => k.endsWith(`/${piece.id}/${variation.id}.astro`));
const Component = key ? (modules[key] as any).default : null;

const isRest = state === "rest";
const props = isRest
  ? kitSamples[variation.id] ?? {}
  : { ...(kitSamples[variation.id] ?? {}), ...statePropsFor(variation.id, state as KitDemoState) };

// Only a driven state gets a driver. `hover` deliberately gets none: it renders at rest, and the
// chrome around the frame says why, because a hovered-looking render nobody hovered is a lie.
const drive = !isRest && STATE_KIND[state as KitDemoState] === "driven";
---
<BaseLayout
  title={`${variation.name}, ${isRest ? "at rest" : state}`}
  description={variation.when}
  noindex={true}
  chrome={false}
>
  {Component ? <Component {...props} /> : (
    <div class="kit-container" style="padding-block: var(--kit-space-3xl)">
      <p class="kit-empty">This variation is declared in the manifest and has no component.</p>
    </div>
  )}
  {drive && <StateDriver state={state} openTarget={OPEN_TARGET[variation.id] ?? ""} />}
  <p class="frame-status" data-kit-driver-status role="status" aria-live="polite"></p>
</BaseLayout>
<style is:global>
  /**
   * THE PIECE, AND NOTHING ELSE IN THE DOCUMENT.
   *
   * A build that has grown a real site header renders it from the layout on every page, and a
   * navigation piece shown underneath the client's actual navigation is not the piece anybody is
   * reviewing. `chrome={false}` above is the polite way of asking; this is the guarantee, because
   * a layout that never learned about that prop would otherwise put the whole site around a
   * single section. The layout is still BaseLayout on purpose: the kit has to be demonstrated in
   * the configuration it ships in, view transitions included, since the one defect that made
   * every form in the kit dead was caused by exactly that router and would have been invisible in
   * a stripped-down demo harness.
   */
  body > header,
  body > footer,
  body > nav { display: none !important; }
</style>
<style>
  /* Only ever seen when this URL is opened on its own; inside the viewer the parent shows it. */
  .frame-status:empty { display: none; }
  .frame-status {
    max-width: var(--kit-page-max);
    margin: var(--kit-space-lg) auto 0;
    padding-inline: var(--kit-page-pad);
    font-size: var(--kit-text-sm);
    color: var(--kit-text-muted);
  }
</style>
<script>
  /**
   * Tells the parent how tall this document actually is, so the frame around it has no scrollbar
   * and no gap. Reported on load, on resize, and whenever the parent asks after changing width,
   * because a width change re-lays the document and invalidates the last answer.
   */
  (() => {
    if (window.parent === window) return;
    /**
     * ONLY WHEN IT ACTUALLY MOVED, and by more than a pixel of rounding.
     *
     * The parent answers a height by resizing the frame, which changes this document's viewport,
     * which changes what an observer measures. Reporting every measurement would put the two
     * documents in a loop that never settles and looks like a flickering page. Reporting only a
     * real change ends it after one round.
     */
    let last = -1;
    const measure = () => {
      const height = Math.max(
        document.documentElement.scrollHeight,
        document.body ? document.body.scrollHeight : 0,
      );
      if (Math.abs(height - last) < 2) return;
      last = height;
      window.parent.postMessage({ kitFrameHeight: height }, window.location.origin);
    };
    window.addEventListener("load", measure);
    window.addEventListener("resize", measure);
    window.addEventListener("message", (event) => {
      if (event.origin !== window.location.origin) return;
      if ((event.data as { kitFrameMeasure?: boolean })?.kitFrameMeasure) {
        last = -1; // The width changed, so the last answer is stale rather than merely old.
        window.requestAnimationFrame(measure);
      }
    });
    // A driven state changes the height after the driver runs, and an accordion changes it when
    // the reader presses something, so watch rather than measure once.
    if ("ResizeObserver" in window) new ResizeObserver(measure).observe(document.documentElement);
    measure();
  })();
</script>
