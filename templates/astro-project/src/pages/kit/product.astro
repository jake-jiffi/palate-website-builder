---
/**
 * EXAMPLE PAGE 1 OF 3: A PRODUCT HOME PAGE, BUILT ONLY FROM KIT PIECES.
 *
 * The per-variation pages under /kit/<piece>/<id> prove each component renders. They cannot prove
 * the harder thing, which is that fifteen sections built independently sit together as one page:
 * that the grounds alternate instead of running into each other, that the headings descend in
 * order, that the argument moves from claim to proof to price to objection, and that every piece
 * accepts real content rather than the defaults it was written around.
 *
 * So every content prop here is passed, because a page of defaults would only re-prove what the
 * variation pages already prove. The only defaults left standing are the messages for states this
 * page never enters (an empty list, JavaScript turned off).
 *
 * THE BUSINESS IS INVENTED. Paddockline is not a real product, the farms are not real farms and
 * the quotes are not real people. A kit example that borrows a real company's words is a kit
 * example nobody can ship.
 *
 * ORDER follows each piece's own `where` guidance in src/lib/kit.ts, which is the point: nav,
 * hero, trust, problem, benefits, demonstration, use cases, proof, price, comparison, questions,
 * close. GROUND alternates deliberately (default, subtle, default) with the two inverse bands as
 * punctuation, because two adjacent sections on the same ground read as one long section.
 *
 * Images are left unset on purpose. Every piece that takes one renders its own ratio box, which
 * is the honest state for a template: a real build fills them, and nothing here 404s in the
 * meantime. DemoScreenshots is the exception, because it requires a path and has no unset state,
 * so it points at public/images/kit/placeholder.svg, an image with nothing in it.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavDropdown from "../../components/kit/navigation/NavDropdown.astro";
import HeroCentredPreview from "../../components/kit/hero/HeroCentredPreview.astro";
import TrustLogos from "../../components/kit/trust/TrustLogos.astro";
import ProblemSideBySide from "../../components/kit/problem/ProblemSideBySide.astro";
import BenefitCards from "../../components/kit/benefits/BenefitCards.astro";
import DemoScreenshots from "../../components/kit/demo/DemoScreenshots.astro";
import DemoEntryPoint from "../../components/kit/demo/DemoEntryPoint.astro";
import UseCasesIndustry from "../../components/kit/usecases/UseCasesIndustry.astro";
import CtaBanner from "../../components/kit/cta/CtaBanner.astro";
import TestimonialGrid from "../../components/kit/testimonials/TestimonialGrid.astro";
import PricingCards from "../../components/kit/pricing/PricingCards.astro";
import CompareAlternatives from "../../components/kit/comparison/CompareAlternatives.astro";
import FaqAccordion from "../../components/kit/faq/FaqAccordion.astro";
import CtaClosing from "../../components/kit/cta/CtaClosing.astro";
import FooterGrouped from "../../components/kit/footer/FooterGrouped.astro";
